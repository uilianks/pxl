{
  "name": "pxl-pixelart",
  "version": "0.1.0",
  "description": "A compact pixel-art DSL for AI agents and humans: sprites, layers, scenes, sheets, with a live painting viewer.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pxl": "./bin/pxl.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "scripts",
    "types",
    "examples/*.px.js",
    "SKILL.md",
    "reference.md",
    "lighting.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "node scripts/build.js",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "examples": "node scripts/examples.ts",
    "check": "npm run typecheck && npm test && npm run examples"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "pixel-art",
    "sprites",
    "dsl",
    "gamedev",
    "sprite-sheet",
    "ai-agent",
    "claude-code",
    "skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uilianks/pxl.git"
  },
  "homepage": "https://github.com/uilianks/pxl#readme",
  "bugs": {
    "url": "https://github.com/uilianks/pxl/issues"
  }
}
